// nanomig_hdmi.cst - pins available in the hdmi variants only

// digital video
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// generic IO pins used for DB9 port 1 (mouse & joystick)
IO_LOC "js0[0]" 27;
IO_PORT "js0[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js0[1]" 28;
IO_PORT "js0[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js0[2]" 25;
IO_PORT "js0[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js0[3]" 26;
IO_PORT "js0[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js0[4]" 29;
IO_PORT "js0[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js0[5]" 30;
IO_PORT "js0[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// spare IO pins used for 2nd DB9 port
IO_LOC "js1[0]" 73;
IO_PORT "js1[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js1[1]" 74;
IO_PORT "js1[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js1[2]" 77;
IO_PORT "js1[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js1[3]" 31;
IO_PORT "js1[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js1[4]" 49;
IO_PORT "js1[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "js1[5]" 52;
IO_PORT "js1[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// connection to the external BL616/M0S
IO_LOC "m0s[0]" 42;
IO_PORT "m0s[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s[1]" 41;
IO_PORT "m0s[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s[2]" 56;
IO_PORT "m0s[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s[3]" 54;
IO_PORT "m0s[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s[4]" 51;
IO_PORT "m0s[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// MIDI
IO_LOC "midi_out" 71;
IO_PORT "midi_out" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC "midi_in" 72;
IO_PORT "midi_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// BUZZER for floppy & HDD drive sounds
IO_LOC "buzzer" 53;
IO_PORT "buzzer" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=DOWN;
