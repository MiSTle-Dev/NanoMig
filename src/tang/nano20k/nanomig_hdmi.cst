// nanomig_hdmi.cst - pins available in the hdmi variants only

// digital video
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// generic IO pins used for DB9 port 1 (mouse & joystick)
IO_LOC "joya[0]" 27;
IO_PORT "joya[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joya[1]" 28;
IO_PORT "joya[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joya[2]" 25;
IO_PORT "joya[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joya[3]" 26;
IO_PORT "joya[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joya[4]" 29;
IO_PORT "joya[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joya[5]" 30;
IO_PORT "joya[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// spare IO pins used for 2nd DB9 port
IO_LOC "joyb[0]" 73;
IO_PORT "joyb[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joyb[1]" 74;
IO_PORT "joyb[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joyb[2]" 77;
IO_PORT "joyb[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joyb[3]" 31;
IO_PORT "joyb[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joyb[4]" 49;
IO_PORT "joyb[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "joyb[5]" 52;
IO_PORT "joyb[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// FPGA Companion
IO_LOC "companion_ss" 56;
IO_PORT "companion_ss" PULL_MODE=UP IO_TYPE=LVCMOS33; 
IO_LOC "companion_clk" 54;
IO_PORT "companion_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33; 
IO_LOC "companion_dout" 42;
IO_PORT "companion_dout" PULL_MODE=NONE IO_TYPE=LVCMOS33; 
IO_LOC "companion_din" 41;
IO_PORT "companion_din" PULL_MODE=NONE IO_TYPE=LVCMOS33; 
IO_LOC "companion_intn" 51;
IO_PORT "companion_intn" PULL_MODE=UP IO_TYPE=LVCMOS33; 

// MIDI
IO_LOC "midi_out" 71;
IO_PORT "midi_out" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_LOC "midi_in" 72;
IO_PORT "midi_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// BUZZER for floppy & HDD drive sounds
IO_LOC "buzzer" 53;
IO_PORT "buzzer" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=DOWN;
