// nanomig_lcd_companion.cst - pins to use alternatice companion pins with lcd

IO_LOC "companion_dout" 71;
IO_PORT "companion_dout" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "companion_din" 72;
IO_PORT "companion_din" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "companion_ss" 73;
IO_PORT "companion_ss" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "companion_clk" 74;
IO_PORT "companion_clk" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "companion_intn" 52;
IO_PORT "companion_intn" PULL_MODE=UP IO_TYPE=LVCMOS33;